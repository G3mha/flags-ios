# Copy to fastlane/.env and fill in. That file is gitignored.
#
# fastlane loads it from the project you are standing in, so these never leak
# into another repo's lanes and you never export them by hand.
#
# From App Store Connect -> Users and Access -> Integrations -> App Store
# Connect API. The Key ID is on the row; the Issuer ID is above the table.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

# Keep the .p8 out of the repository. It is a credential for the whole
# account, and it downloads exactly once.
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# fastlane complains on every run without these.
LC_ALL=en_US.UTF-8
LANG=en_US.UTF-8
