# Lanes for the personal App Store Connect account.
#
# This machine also carries lanes for a company account. Nothing is shared
# between them: authentication is an App Store Connect API key rather than an
# Apple ID, so there is no Keychain session, no ~/.fastlane/spaceship cookie
# and no match repository for the two to fight over. Two keys are two files.
#
# Set up once:
#
#   App Store Connect -> Users and Access -> Integrations -> App Store Connect
#   API -> generate a key with the App Manager role. You get a .p8 that
#   downloads ONCE, a Key ID and an Issuer ID.
#
#   cp fastlane/.env.example fastlane/.env    # then fill it in
#
# Use fastlane/.env rather than exporting. fastlane reads it from whichever
# project you are standing in, so the right account is picked for you and a
# shell that once exported the company's key cannot reach this app. The file
# is ignored by git.
#
# Keep the .p8 outside the repository -- ~/.appstoreconnect/private_keys is
# the usual home, and holds several keys side by side without clashing. It is
# a credential for the whole account. *.p8 is ignored here too, so a stray
# copy cannot be committed, but out of the tree is better than ignored.

require "fileutils"
require "tmpdir"

default_platform(:ios)

REQUIRED = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].freeze

# Fails before anything talks to Apple, rather than halfway through an upload.
def asc_api_key
  missing = REQUIRED.reject { |name| ENV[name].to_s.strip != "" }
  UI.user_error!("Set #{missing.join(', ')} first -- see the comment at the top of this file.") if missing.any?

  path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("No key at #{path}") unless File.exist?(path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: path,
    in_house: false,
  )
end

# Exports the archive by hand, because gym cannot do it under Xcode 26.
#
# Xcode 26 renamed the App Store export method from "app-store" to
# "app-store-connect" and rejects the old spelling outright:
#
#   error: exportArchive exportOptionsPlist error for key "method"
#          expected one {} but found app-store
#
# gym only accepts the old name -- its export_method rejects anything outside
# a fixed list -- and it overwrites the plist's method key with that value
# unconditionally, so there is no way to smuggle the new spelling past it.
# fastlane 2.240.1 is the latest release as of 2026-09-26 and has the same
# problem, so this is not one upgrade away. Delete all of this the day gym
# learns the new name.
def export_archive(archive_path)
  UI.user_error!("No archive to export") if archive_path.nil? || !File.exist?(archive_path)

  output = File.expand_path("../build/fastlane", __dir__)
  FileUtils.mkdir_p(output)

  plist = File.join(Dir.mktmpdir("flags-export"), "ExportOptions.plist")
  File.write(plist, <<~XML)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>app-store-connect</string>
      <key>signingStyle</key>
      <string>automatic</string>
      <key>teamID</key>
      <string>#{CredentialsManager::AppfileConfig.try_fetch_value(:team_id)}</string>
      <key>uploadSymbols</key>
      <true/>
    </dict>
    </plist>
  XML

  sh("xcodebuild", "-exportArchive",
     "-archivePath", archive_path,
     "-exportOptionsPlist", plist,
     "-exportPath", output,
     "-allowProvisioningUpdates")

  ipa = Dir[File.join(output, "*.ipa")].max_by { |f| File.mtime(f) }
  UI.user_error!("Export produced no .ipa in #{output}") if ipa.nil?
  UI.success("Exported #{File.basename(ipa)}")
  ipa
end

platform :ios do
  desc "Push fastlane/metadata to App Store Connect. Previews first; pass force:true to skip."
  lane :metadata do |options|
    api_key = asc_api_key

    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      # You press Submit. A lane that submits is a lane that can submit by
      # accident, and a rejected version is not the moment to find that out.
      submit_for_review: false,
      # false shows an HTML preview of every field it is about to overwrite,
      # and asks. Worth reading the first few times.
      force: options[:force] || false,
      precheck_include_in_app_purchases: false,
    )
  end

  desc "Build the app and upload it to TestFlight. Does not submit anything."
  lane :beta do
    api_key = asc_api_key

    # The watch app and both widget extensions are embedded by this scheme, so
    # one archive carries all four targets. -allowProvisioningUpdates is what
    # lets xcodebuild register the iCloud and app group capabilities; without
    # it a signed build fails complaining the profile lacks them.
    #
    # Archive only. gym cannot package this -- see export_archive below.
    build_app(
      project: "Flags.xcodeproj",
      scheme: "Flags",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates",
      skip_package_ipa: true,
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: export_archive(lane_context[SharedValues::XCODEBUILD_ARCHIVE]),
      # Uploading and waiting are different jobs. Apple's processing takes as
      # long as it takes, and holding the terminal open for it helps nobody.
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "Check the key actually works, without changing anything."
  lane :whoami do
    asc_api_key

    # A real round trip on purpose. Building the token proves only that the
    # .p8 parses -- a wrong issuer id, a revoked key or a key from the other
    # account all survive that and fail later, mid-upload. Asking Apple
    # something harmless is what tells you the credentials are good.
    bundle_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    app = Spaceship::ConnectAPI::App.find(bundle_id)

    if app
      UI.success("Key #{ENV['ASC_KEY_ID']} reaches #{app.name} (#{bundle_id}).")
    else
      UI.success("Key #{ENV['ASC_KEY_ID']} works. No app record for #{bundle_id} yet -- " \
                 "create it in App Store Connect before uploading a build.")
    end
  end
end
